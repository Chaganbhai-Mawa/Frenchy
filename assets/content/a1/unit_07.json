          ]
        },
        {
          "type": "grammar",
          "title": "Grammar",
          "blocks": [
            {
              "heading": "-er verbs in the present",
              "body": "Regular -er verbs all follow the same pattern. Take off -er and add the ending: je travaille (-e), tu travailles (-es), il/elle travaille (-e). The three forms are spelled differently but pronounced exactly the same.",
              "examples": [
                { "french": "Je travaille à Lyon.", "english": "I work in Lyon.", "note": "je + -e" },
                { "french": "Tu travailles beaucoup !", "english": "You work a lot!", "note": "tu + -es" },
                { "french": "Elle travaille le matin.", "english": "She works in the morning.", "note": "il/elle + -e" },
                { "french": "Vous travaillez ici ?", "english": "Do you work here?", "note": "vous + -ez" },
                { "french": "Nous mangeons à midi.", "english": "We eat at noon.", "note": "nous + -ons; manger keeps an e: mangeons" },
                { "french": "Elles écoutent de la musique.", "english": "They listen to music.", "note": "-ent is silent" }
              ],
              "tip": "This pattern works for thousands of verbs: manger, regarder, écouter, étudier... Learn it once, use it everywhere!"
            }
          ]
        },
