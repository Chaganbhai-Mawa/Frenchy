          ]
        },
        {
          "type": "grammar",
          "title": "Grammar",
          "blocks": [
            {
              "heading": "Reflexive verbs: je me lève",
              "body": "Reflexive verbs carry a little pronoun that matches the subject: je ME lève, tu TE lèves, il/elle SE lève. It always sits right before the verb. Before a vowel, me, te and se become m', t' and s': je m'habille, il s'habille.",
              "examples": [
                { "french": "Je me lève à sept heures.", "english": "I get up at seven o'clock." },
                { "french": "Tu te lèves tôt ?", "english": "Do you get up early?" },
                { "french": "Elle se douche.", "english": "She takes a shower." },
                { "french": "Je m'habille.", "english": "I get dressed.", "note": "m' before a vowel sound" },
                { "french": "Nous nous levons à sept heures.", "english": "We get up at seven o'clock.", "note": "nous NOUS levons" },
                { "french": "Ils se préparent vite.", "english": "They get ready quickly." }
              ],
              "tip": "Compare: \"je lave la voiture\" (I wash the car) but \"je me lave\" (I wash myself). The pronoun shows the action comes back to you."
            }
          ]
        },
