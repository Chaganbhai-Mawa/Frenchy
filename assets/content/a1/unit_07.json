            { "id": "se-laver", "french": "se laver", "english": "to wash (oneself)", "partOfSpeech": "verb", "pronunciation": "suh lah-VAY", "example": "Je me lave le matin.", "exampleEnglish": "I wash in the morning.", "level": "A1", "category": "daily-routine" },
