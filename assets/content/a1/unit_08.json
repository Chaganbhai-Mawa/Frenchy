        {
          "type": "grammar",
          "title": "Grammar",
          "blocks": [
            {
              "heading": "Three ways to ask a question",
              "body": "French has three ways to ask the same question. Easiest: keep the sentence order and add the question word at the end (\"Tu arrives quand ?\"). Neutral: use \"est-ce que\" (\"Quand est-ce que tu arrives ?\"). Formal: invert the verb and pronoun (\"Quand arrives-tu ?\").",
              "examples": [
                { "french": "Tu arrives quand ?", "english": "When do you arrive?", "note": "spoken, informal" },
                { "french": "Quand est-ce que tu arrives ?", "english": "When do you arrive?", "note": "neutral" },
                { "french": "Quand arrives-tu ?", "english": "When do you arrive?", "note": "formal" },
                { "french": "Tu pars quand en vacances ?", "english": "When are you going on holiday?", "note": "spoken, informal" },
                { "french": "Quand est-ce que la fête commence ?", "english": "When does the party start?", "note": "neutral" }
              ],
              "tip": "In everyday conversation, French speakers mostly use the first two. Inversion sounds a little formal."
            }
          ]
        },
