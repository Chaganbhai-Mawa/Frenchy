            { "id": "week-end", "french": "le week-end", "english": "weekend", "partOfSpeech": "noun", "gender": "m", "pronunciation": "week-END", "example": "Le week-end, je reste à la maison.", "exampleEnglish": "On the weekend, I stay at home.", "level": "A1", "category": "time" }
          ]
        },
        {
          "type": "grammar",
          "title": "Grammar",
          "blocks": [
            {
              "heading": "Quel or quelle?",
              "body": "\"Quel\" means \"which\" or \"what\". It agrees with the noun: \"quel\" before a masculine noun, \"quelle\" before a feminine noun. Good news — both sound exactly the same!",
              "examples": [
                { "french": "Quel jour sommes-nous ?", "english": "What day is it?", "note": "jour is masculine" },
                { "french": "Quelle heure est-il ?", "english": "What time is it?", "note": "heure is feminine" },
                { "french": "Quel est ton mois préféré ?", "english": "What is your favourite month?" },
                { "french": "Quelle est la date aujourd'hui ?", "english": "What is the date today?", "note": "date is feminine" },
                { "french": "Quel est ton jour préféré ?", "english": "What is your favourite day?" }
              ],
              "tip": "You only hear the difference in writing. When speaking, just say \"kel\" and smile."
            }
          ]
        },
