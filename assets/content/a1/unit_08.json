          ]
        },
        {
          "type": "grammar",
          "title": "Grammar",
          "blocks": [
            {
              "heading": "Il est + time",
              "body": "Time always uses \"il est\" — never \"c'est\" or \"nous sommes\". \"Heure\" takes an s from two o'clock on (\"deux heures\"), but stays singular for \"une heure\". Note that one o'clock uses \"une\" (feminine), because \"heure\" is a feminine noun.",
              "examples": [
                { "french": "Il est une heure.", "english": "It is one o'clock.", "note": "une, not un" },
                { "french": "Il est sept heures.", "english": "It is seven o'clock." },
                { "french": "Il est midi et demi.", "english": "It is half past twelve." },
                { "french": "Il est six heures dix.", "english": "It is 6:10.", "note": "minutes simply follow the hour" },
                { "french": "Il est deux heures vingt.", "english": "It is 2:20." }
              ],
              "tip": "In everyday speech, minutes simply follow the hour: \"Il est six heures dix\" — it is 6:10."
            }
          ]
        },
