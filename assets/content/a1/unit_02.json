            { "id": "deux", "french": "deux", "english": "two", "partOfSpeech": "number", "pronunciation": "duh", "example": "J'ai deux sœurs.", "exampleEnglish": "I have two sisters.", "level": "A1", "category": "numbers" },
            { "id": "trois", "french": "trois", "english": "three", "partOfSpeech": "number", "pronunciation": "trwah", "example": "Nous sommes trois.", "exampleEnglish": "There are three of us.", "level": "A1", "category": "numbers" },
