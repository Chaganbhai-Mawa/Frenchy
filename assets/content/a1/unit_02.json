            { "id": "huit", "french": "huit", "english": "eight", "partOfSpeech": "number", "pronunciation": "weet", "example": "Le magasin ouvre à huit heures.", "exampleEnglish": "The shop opens at eight o'clock.", "level": "A1", "category": "numbers" },
            { "id": "neuf", "french": "neuf", "english": "nine", "partOfSpeech": "number", "pronunciation": "nuhf", "example": "Mon frère a neuf ans.", "exampleEnglish": "My brother is nine years old.", "level": "A1", "category": "numbers" }
          ]
        },
        {
          "type": "grammar",
          "title": "Grammar",
          "blocks": [
            {
              "heading": "Être and avoir — je and tu",
              "body": "\"Être\" (to be) and \"avoir\" (to have) are the two most important French verbs. For now, learn the \"I\" and \"you\" forms: je suis / tu es (I am / you are), and j'ai / tu as (I have / you have). Note the elision: \"je ai\" becomes \"j'ai\".",
              "examples": [
                { "french": "Je suis Marie.", "english": "I am Marie." },
                { "french": "Tu es étudiant ?", "english": "Are you a student?" },
                { "french": "J'ai huit ans.", "english": "I am eight years old." },
                { "french": "Tu as quel âge ?", "english": "How old are you? (casual word order)" },
                { "french": "Je suis content.", "english": "I am happy." },
                { "french": "Tu as un chat ?", "english": "Do you have a cat?" }
              ],
              "tip": "Use \"être\" for who you are, \"avoir\" for what you have — and remember, in French your age is something you HAVE."
            }
          ]
        },
