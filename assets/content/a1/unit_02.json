    {
      "id": "a1_u02_l03",
      "level": "A1",
      "unit": 2,
      "title": "Où habites-tu ?",
      "description": "Say where you live and where you come from.",
      "estimatedMinutes": 12,
      "sections": [
        {
          "type": "learn",
          "title": "Learn",
          "blocks": [
            {
              "heading": "Where you live",
              "body": "To say where you live, use \"j'habite à\" + a city: \"J'habite à Paris.\" To ask, say \"Où habites-tu ?\" (informal) or \"Où habitez-vous ?\" (formal). The h in \"habiter\" is silent, so \"je habite\" becomes \"j'habite\".",
              "examples": [
                { "french": "J'habite à Paris.", "english": "I live in Paris." },
                { "french": "Où habites-tu ?", "english": "Where do you live? (informal)" },
                { "french": "Où habitez-vous ?", "english": "Where do you live? (formal)" },
                { "french": "J'habite dans un petit village.", "english": "I live in a small village." },
                { "french": "Nous habitons à Marseille.", "english": "We live in Marseille." }
              ]
            },
            {
              "heading": "Where you come from",
              "body": "To say your origin, use \"je viens de\" + a city: \"Je viens de Londres.\" To ask, say \"D'où viens-tu ?\" — \"de\" + \"où\" contracts to \"d'où\" (from where). For a country, say \"Je viens de France\" or \"J'habite en France\".",
              "examples": [
                { "french": "Je viens de Londres.", "english": "I come from London." },
                { "french": "D'où viens-tu ?", "english": "Where are you from? (informal)" },
                { "french": "J'habite en France.", "english": "I live in France." },
                { "french": "Je viens du Canada.", "english": "I come from Canada.", "note": "de + le → du" },
                { "french": "Elle vient d'Italie.", "english": "She comes from Italy.", "note": "de + vowel → d'" }
              ],
              "tip": "Cities take \"à\" (à Paris, à Lyon); most countries take \"en\" (en France, en Italie)."
            }
          ]
        },
        {
          "type": "vocabulary",
          "title": "Vocabulary",
          "items": [
