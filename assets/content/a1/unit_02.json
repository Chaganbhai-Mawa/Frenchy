            { "id": "ici", "french": "ici", "english": "here", "partOfSpeech": "adverb", "pronunciation": "ee-SEE", "example": "J'habite ici.", "exampleEnglish": "I live here.", "level": "A1", "category": "places" },
            { "id": "le-village", "french": "le village", "english": "village", "partOfSpeech": "noun", "gender": "m", "plural": "villages", "pronunciation": "vee-LAHZH", "example": "J'habite dans un petit village.", "exampleEnglish": "I live in a small village.", "level": "A1", "category": "places" },
            { "id": "la-capitale", "french": "la capitale", "english": "capital city", "partOfSpeech": "noun", "gender": "f", "plural": "capitales", "pronunciation": "kah-pee-TAHL", "example": "Paris est la capitale de la France.", "exampleEnglish": "Paris is the capital of France.", "level": "A1", "category": "places" },
