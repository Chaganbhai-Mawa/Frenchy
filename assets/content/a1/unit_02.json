            { "id": "l-adresse", "french": "l'adresse", "english": "address", "partOfSpeech": "noun", "gender": "f", "plural": "adresses", "pronunciation": "ah-DRESS", "example": "Quelle est ton adresse ?", "exampleEnglish": "What is your address?", "level": "A1", "category": "places" },
            { "id": "la-bas", "french": "là-bas", "english": "over there", "partOfSpeech": "adverb", "pronunciation": "lah-BAH", "example": "Ma famille habite là-bas.", "exampleEnglish": "My family lives over there.", "level": "A1", "category": "places" },
            { "id": "mais", "french": "mais", "english": "but", "partOfSpeech": "conjunction", "pronunciation": "meh", "example": "J'habite à Lyon, mais je viens de Nice.", "exampleEnglish": "I live in Lyon, but I come from Nice.", "level": "A1", "category": "basics" }
          ]
