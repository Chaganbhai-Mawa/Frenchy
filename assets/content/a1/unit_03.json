      "estimatedMinutes": 13,
      "sections": [
        {
          "type": "learn",
          "title": "Learn",
          "blocks": [
            {
              "heading": "How much? How many?",
              "body": "\"Combien\" means \"how much\" or \"how many\". To ask a price, say \"C'est combien ?\" (How much is it?) or \"Combien ça coûte ?\" (How much does it cost?). The answer uses euros: \"Ça coûte dix euros.\"",
              "examples": [
                { "french": "C'est combien ?", "english": "How much is it?" },
                { "french": "Combien ça coûte ?", "english": "How much does it cost?" },
                { "french": "Ça coûte dix euros.", "english": "It costs ten euros." },
                { "french": "C'est trois euros cinquante.", "english": "It's three euros fifty." },
                { "french": "Ça coûte cinquante centimes.", "english": "It costs fifty cents." },
                { "french": "C'est gratuit !", "english": "It's free!" }
              ],
              "tip": "For prices like €3.50, French says \"trois euros cinquante\" — the word \"euros\" goes in the middle."
            },
            {
              "heading": "Phone numbers",
              "body": "French phone numbers have ten digits, read in five pairs: 06 12 34 56 78 = zéro six, douze, trente-quatre, cinquante-six, soixante-dix-huit. To ask, say \"Quel est ton numéro de téléphone ?\"",
              "examples": [
                { "french": "Quel est ton numéro de téléphone ?", "english": "What is your phone number? (informal)" },
                { "french": "Mon numéro, c'est le 06 12 34 56 78.", "english": "My number is 06 12 34 56 78." },
                { "french": "Quel est votre numéro de téléphone ?", "english": "What is your phone number? (formal)" },
                { "french": "Tu peux répéter, s'il te plaît ?", "english": "Can you repeat, please?" }
              ],
              "tip": "Practise reading numbers two digits at a time — that's how every French speaker says a phone number."
            }
          ]
        },
