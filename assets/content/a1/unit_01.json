    {
      "id": "a1_u01_l02",
      "level": "A1",
      "unit": 1,
      "title": "Ça va ?",
      "description": "Ask people how they are — and answer naturally.",
      "estimatedMinutes": 12,
      "sections": [
        {
          "type": "learn",
          "title": "Learn",
          "blocks": [
            {
              "heading": "How are you?",
              "body": "The easiest way to ask \"how are you?\" is \"Ça va ?\" (literally: \"it goes?\"). The same words also work as the answer: \"Ça va !\" — I'm fine. For polite situations, use \"Comment allez-vous ?\"",
              "examples": [
                { "french": "Ça va ?", "english": "How are you? (informal)" },
                { "french": "Ça va bien, merci.", "english": "I'm fine, thanks." },
                { "french": "Comment allez-vous ?", "english": "How are you? (formal)" },
                { "french": "Très bien, merci. Et vous ?", "english": "Very well, thanks. And you?" },
                { "french": "Ça va mal.", "english": "Things are going badly." },
                { "french": "Pas mal, et toi ?", "english": "Not bad, and you?" }
              ],
              "tip": "\"Ça va ?\" — \"Ça va !\" Question and answer can be exactly the same words. Only the intonation changes!"
            }
          ]
        },
        {
          "type": "vocabulary",
          "title": "Vocabulary",
          "items": [
            { "id": "ca-va", "french": "ça va", "english": "how are you / I'm fine", "partOfSpeech": "expression", "pronunciation": "sah VAH", "example": "Salut, ça va ?", "exampleEnglish": "Hi, how are you?", "level": "A1", "category": "greetings" },
            { "id": "bien", "french": "bien", "english": "well / good", "partOfSpeech": "adverb", "pronunciation": "byahn", "example": "Ça va bien.", "exampleEnglish": "I'm doing well.", "level": "A1", "category": "basics" },
            { "id": "tres", "french": "très", "english": "very", "partOfSpeech": "adverb", "pronunciation": "treh", "example": "Très bien, merci !", "exampleEnglish": "Very well, thank you!", "level": "A1", "category": "basics" },
            { "id": "et", "french": "et", "english": "and", "partOfSpeech": "conjunction", "pronunciation": "ay", "example": "Et vous ?", "exampleEnglish": "And you?", "level": "A1", "category": "basics" },
            { "id": "vous", "french": "vous", "english": "you (formal / plural)", "partOfSpeech": "pronoun", "pronunciation": "voo", "example": "Comment allez-vous ?", "exampleEnglish": "How are you?", "level": "A1", "category": "basics" },
            { "id": "toi", "french": "toi", "english": "you (informal)", "partOfSpeech": "pronoun", "pronunciation": "twah", "example": "Et toi ?", "exampleEnglish": "And you?", "level": "A1", "category": "basics" },
            { "id": "comme-ci-comme-ca", "french": "comme ci, comme ça", "english": "so-so", "partOfSpeech": "expression", "pronunciation": "kom SEE kom SAH", "example": "Ça va ? — Comme ci, comme ça.", "exampleEnglish": "How are you? — So-so.", "level": "A1", "category": "greetings" },
            { "id": "fatigue", "french": "fatigué", "english": "tired", "partOfSpeech": "adjective", "pronunciation": "fah-tee-GAY", "example": "Je suis fatigué.", "exampleEnglish": "I am tired.", "level": "A1", "category": "emotions" },
            { "id": "mal", "french": "mal", "english": "badly", "partOfSpeech": "adverb", "pronunciation": "mahl", "example": "Ça va mal aujourd'hui.", "exampleEnglish": "Things are going badly today.", "level": "A1", "category": "basics" },
            { "id": "content", "french": "content", "english": "happy / glad", "partOfSpeech": "adjective", "pronunciation": "kohn-TAHN", "example": "Je suis content de te voir.", "exampleEnglish": "I am happy to see you.", "level": "A1", "category": "emotions" },
            { "id": "triste", "french": "triste", "english": "sad", "partOfSpeech": "adjective", "pronunciation": "treest", "example": "Il est triste ce soir.", "exampleEnglish": "He is sad this evening.", "level": "A1", "category": "emotions" },
            { "id": "malade", "french": "malade", "english": "sick / ill", "partOfSpeech": "adjective", "pronunciation": "mah-LAHD", "example": "Elle est malade aujourd'hui.", "exampleEnglish": "She is sick today.", "level": "A1", "category": "emotions" },
            { "id": "super", "french": "super", "english": "great / super", "partOfSpeech": "adjective", "pronunciation": "su-PEHR", "example": "Super ! Merci beaucoup !", "exampleEnglish": "Great! Thank you very much!", "level": "A1", "category": "basics" },
            { "id": "tu", "french": "tu", "english": "you (informal)", "partOfSpeech": "pronoun", "pronunciation": "tew", "example": "Tu vas bien ?", "exampleEnglish": "Are you well?", "level": "A1", "category": "basics" }
          ]
        },
        {
          "type": "grammar",
          "title": "Grammar",
          "blocks": [
            {
              "heading": "Tu or vous?",
              "body": "French has two words for \"you\". \"Tu\" is for one friend, family member or child. \"Vous\" is for strangers, older people, professional situations — and always for more than one person.",
              "examples": [
                { "french": "Tu vas bien ?", "english": "Are you well? (to a friend)", "note": "informal" },
                { "french": "Comment allez-vous ?", "english": "How are you? (polite)", "note": "formal" },
                { "french": "Tu es content ?", "english": "Are you happy? (to a friend)", "note": "informal" },
                { "french": "Vous allez bien, madame ?", "english": "Are you well, ma'am?", "note": "formal" }
              ],
              "tip": "When in doubt, use \"vous\". A French person will invite you to say \"tu\" (« On peut se tutoyer ! ») when they're ready."
            }
          ]
        },
