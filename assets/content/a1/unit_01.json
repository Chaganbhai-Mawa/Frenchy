    {
      "id": "a1_u01_l01",
      "level": "A1",
      "unit": 1,
      "title": "Bonjour !",
      "description": "Your very first French words: greet people at any time of day.",
      "estimatedMinutes": 12,
      "sections": [
        {
          "type": "learn",
          "title": "Learn",
          "blocks": [
            {
              "heading": "Saying hello",
              "body": "\"Bonjour\" literally means \"good day\". French speakers use it from morning until the evening, with everyone — friends, shopkeepers, strangers. In the evening, they switch to \"bonsoir\" (good evening).",
              "examples": [
                { "french": "Bonjour !", "english": "Hello! / Good day!" },
                { "french": "Bonsoir !", "english": "Good evening!" },
                { "french": "Salut !", "english": "Hi! (informal, with friends)" },
                { "french": "Bonjour à tous !", "english": "Hello everyone!" },
                { "french": "Coucou, c'est moi !", "english": "Hey, it's me! (very informal)" }
              ],
              "tip": "In France, always say \"bonjour\" when entering a shop or speaking to someone — skipping it can seem rude."
            },
            {
              "heading": "Formal or informal?",
              "body": "\"Salut\" is only for friends and family. With people you don't know, or in shops and offices, use \"bonjour\" or \"bonsoir\".",
              "examples": [
                { "french": "Salut Marie !", "english": "Hi Marie!", "note": "informal" },
                { "french": "Bonjour, madame.", "english": "Hello, ma'am.", "note": "polite" },
                { "french": "Bonsoir, monsieur.", "english": "Good evening, sir.", "note": "polite" },
                { "french": "Bonjour, mademoiselle.", "english": "Hello, miss.", "note": "polite" },
                { "french": "Coucou Léa !", "english": "Hey Léa!", "note": "very informal" }
              ]
            }
          ]
        },
