      "estimatedMinutes": 10,
      "sections": [
        {
          "type": "learn",
          "title": "Learn",
          "blocks": [
            {
              "heading": "Saying goodbye",
              "body": "\"Au revoir\" is the universal goodbye — it works everywhere. With friends you can simply say \"salut\" (yes, it means both hi and bye!) or \"à bientôt\" (see you soon).",
              "examples": [
                { "french": "Au revoir !", "english": "Goodbye!" },
                { "french": "À bientôt !", "english": "See you soon!" },
                { "french": "À demain !", "english": "See you tomorrow!" },
                { "french": "Bonne journée !", "english": "Have a good day!" },
                { "french": "Bonne nuit !", "english": "Good night! (before sleeping)" },
                { "french": "À plus tard !", "english": "See you later!" }
              ],
              "tip": "Shopkeepers almost always add \"Bonne journée !\" after \"au revoir\" — answer with \"Merci, vous aussi !\" (Thanks, you too!)."
            }
          ]
        },
