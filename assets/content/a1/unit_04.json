            { "id": "gentil", "french": "gentil", "english": "kind / nice", "partOfSpeech": "adjective", "pronunciation": "zhahn-TEE", "example": "Mon père est gentil.", "exampleEnglish": "My father is kind.", "level": "A1", "category": "descriptions" },
