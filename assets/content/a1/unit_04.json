    {
      "id": "a1_u04_l01",
      "level": "A1",
      "unit": 4,
      "title": "Ma famille",
      "description": "Name the members of your family and say \"my\" in French.",
      "estimatedMinutes": 13,
      "sections": [
        {
          "type": "learn",
          "title": "Learn",
          "blocks": [
            {
              "heading": "The family",
              "body": "Here are the core family words: le père (father), la mère (mother), le frère (brother), la sœur (sister). Together, your father and mother are \"les parents\". A son is \"le fils\" and a daughter is \"la fille\" — which also means \"girl\".",
              "examples": [
                { "french": "le père et la mère", "english": "the father and the mother" },
                { "french": "le frère et la sœur", "english": "the brother and the sister" },
                { "french": "les parents", "english": "the parents" },
                { "french": "le fils et la fille", "english": "the son and the daughter" },
                { "french": "l'oncle et la tante", "english": "the uncle and the aunt" },
                { "french": "le cousin et la cousine", "english": "the cousin (male) and the cousin (female)" }
              ],
              "tip": "\"Fils\" is pronounced \"feess\" — the l is silent but the final s is not!"
            }
          ]
        },
        {
          "type": "vocabulary",
          "title": "Vocabulary",
