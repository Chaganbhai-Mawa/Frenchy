            { "id": "elle", "french": "elle", "english": "she / it", "partOfSpeech": "pronoun", "pronunciation": "el", "example": "Elle habite à Paris.", "exampleEnglish": "She lives in Paris.", "level": "A1", "category": "basics" },
            { "id": "grand", "french": "grand", "english": "tall / big", "partOfSpeech": "adjective", "pronunciation": "grahn", "example": "Mon frère est grand.", "exampleEnglish": "My brother is tall.", "level": "A1", "category": "descriptions" },
