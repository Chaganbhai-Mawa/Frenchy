            { "id": "aussi", "french": "aussi", "english": "also / too", "partOfSpeech": "adverb", "pronunciation": "oh-SEE", "example": "Elle est gentille aussi.", "exampleEnglish": "She is kind too.", "level": "A1", "category": "basics" },
            { "id": "la-personne", "french": "la personne", "english": "person", "partOfSpeech": "noun", "gender": "f", "pronunciation": "pehr-SUN", "example": "C'est une personne gentille.", "exampleEnglish": "He/She is a kind person.", "level": "A1", "category": "people" },
            { "id": "beau", "french": "beau", "english": "handsome / beautiful", "partOfSpeech": "adjective", "pronunciation": "boh", "example": "Mon frère est beau.", "exampleEnglish": "My brother is handsome.", "level": "A1", "category": "descriptions" },
            { "id": "joli", "french": "joli", "english": "pretty", "partOfSpeech": "adjective", "pronunciation": "zhoh-LEE", "example": "C'est une jolie maison.", "exampleEnglish": "It's a pretty house.", "level": "A1", "category": "descriptions" },
            { "id": "vieux", "french": "vieux", "english": "old", "partOfSpeech": "adjective", "pronunciation": "vyuh", "example": "Mon grand-père est vieux.", "exampleEnglish": "My grandfather is old.", "level": "A1", "category": "descriptions" },
            { "id": "sympa", "french": "sympa", "english": "nice / friendly (informal)", "partOfSpeech": "adjective", "pronunciation": "sam-PAH", "example": "Ma cousine est très sympa.", "exampleEnglish": "My cousin is very nice.", "level": "A1", "category": "descriptions" },
            { "id": "les-cheveux", "french": "les cheveux", "english": "hair", "partOfSpeech": "noun", "gender": "m", "plural": "cheveux", "pronunciation": "shuh-VUH", "example": "Elle a les cheveux longs.", "exampleEnglish": "She has long hair.", "level": "A1", "category": "body" },
            { "id": "les-yeux", "french": "les yeux", "english": "eyes", "partOfSpeech": "noun", "gender": "m", "plural": "yeux", "pronunciation": "lay ZYUH", "example": "Il a les yeux bleus.", "exampleEnglish": "He has blue eyes.", "level": "A1", "category": "body" }
          ]
        },
        {
          "type": "grammar",
          "title": "Grammar",
          "blocks": [
            {
              "heading": "Être and avoir with il / elle",
              "body": "Third person singular: il est / elle est (he is / she is), il a / elle a (he has / she has). Remember: age uses avoir even for other people — \"Il a cinq ans\", never \"Il est cinq ans\".",
              "examples": [
                { "french": "Il est petit.", "english": "He is short." },
                { "french": "Elle est grande.", "english": "She is tall." },
                { "french": "Il a douze ans.", "english": "He is twelve years old." },
                { "french": "Elle a un frère.", "english": "She has a brother." },
                { "french": "Il est jeune, elle est jeune aussi.", "english": "He is young, she is young too.", "note": "jeune doesn't change" },
                { "french": "Elle a les cheveux longs.", "english": "She has long hair." }
              ],
              "tip": "Adjectives agree with the person: il est grand, but elle est grandE — listen for that extra consonant sound."
            }
          ]
        },
