        {
          "type": "grammar",
          "title": "Grammar",
          "blocks": [
            {
              "heading": "Masculine → feminine",
              "body": "Most nationality adjectives add -e in the feminine: anglais → anglaise, allemand → allemande, américain → américaine. Adjectives ending in -ien double the n: italien → italienne, canadien → canadienne. Adjectives already ending in -e, like suisse or russe, do not change.",
              "examples": [
                { "french": "Il est anglais. → Elle est anglaise.", "english": "He is English. → She is English.", "note": "add -e" },
                { "french": "Il est italien. → Elle est italienne.", "english": "He is Italian. → She is Italian.", "note": "-ien → -ienne" },
                { "french": "Il est suisse. → Elle est suisse.", "english": "He is Swiss. → She is Swiss.", "note": "no change" },
                { "french": "Il est chinois. → Elle est chinoise.", "english": "He is Chinese. → She is Chinese.", "note": "add -e" },
                { "french": "Il est marocain. → Elle est marocaine.", "english": "He is Moroccan. → She is Moroccan.", "note": "add -e" }
              ]
            }
          ]
        },
