        {
          "type": "grammar",
          "title": "Grammar",
          "blocks": [
            {
              "heading": "En, au or aux?",
              "body": "To say you are IN a country, French uses a different little word depending on the country. Use \"en\" with feminine countries, \"au\" with masculine countries, and \"aux\" with plural countries.",
              "examples": [
                { "french": "J'habite en France.", "english": "I live in France.", "note": "en + feminine" },
                { "french": "Il habite au Canada.", "english": "He lives in Canada.", "note": "au + masculine" },
                { "french": "Elle habite aux États-Unis.", "english": "She lives in the United States.", "note": "aux + plural" },
                { "french": "Nous habitons en Belgique.", "english": "We live in Belgium.", "note": "en + feminine" },
                { "french": "Ils habitent au Portugal.", "english": "They live in Portugal.", "note": "au + masculine" },
                { "french": "Tu habites au Maroc ?", "english": "Do you live in Morocco?", "note": "au + masculine" }
              ],
              "tip": "Quick trick: a country ending in -e is usually feminine, so it takes \"en\". Le Mexique is a rare exception — it's masculine: au Mexique."
            }
          ]
        },
