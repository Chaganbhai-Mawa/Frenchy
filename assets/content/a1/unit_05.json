    {
      "id": "a1_u05_l02",
      "level": "A1",
      "unit": 5,
      "title": "Je suis français",
      "description": "Say your nationality and make the adjective agree.",
      "estimatedMinutes": 12,
      "sections": [
        {
          "type": "learn",
          "title": "Learn",
          "blocks": [
            {
              "heading": "Saying your nationality",
              "body": "To give your nationality, use \"je suis\" + a nationality adjective: Je suis français. In French, nationality adjectives are written with a small letter, not a capital. The adjective agrees with the person: a man says \"français\", a woman says \"française\".",
              "examples": [
                { "french": "Je suis français.", "english": "I am French.", "note": "a man speaking" },
                { "french": "Je suis française.", "english": "I am French.", "note": "a woman speaking" },
                { "french": "Il est canadien. Elle est canadienne.", "english": "He is Canadian. She is Canadian." },
                { "french": "Elle est japonaise.", "english": "She is Japanese." },
                { "french": "Nous sommes belges.", "english": "We are Belgian.", "note": "plural adds -s" }
              ],
              "tip": "You can often hear the difference: the final consonant is silent in the masculine (français = frahn-SEH) but pronounced in the feminine (française = frahn-SEZ)."
            }
          ]
        },
        {
          "type": "vocabulary",
          "title": "Vocabulary",
          "items": [
