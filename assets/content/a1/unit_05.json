        {
          "type": "grammar",
          "title": "Grammar",
          "blocks": [
            {
              "heading": "The verb parler",
              "body": "\"Parler\" is a regular -er verb. In the present tense: je parle, tu parles, il/elle parle, nous parlons, vous parlez, ils/elles parlent. Good news: je parle, tu parles, il parle and ils parlent are all pronounced exactly the same!",
              "examples": [
                { "french": "Je parle français.", "english": "I speak French." },
                { "french": "Tu parles anglais ?", "english": "Do you speak English?" },
                { "french": "Vous parlez espagnol ?", "english": "Do you speak Spanish?", "note": "formal or plural" },
                { "french": "Nous parlons français en classe.", "english": "We speak French in class.", "note": "nous + -ons" },
                { "french": "Ils parlent italien.", "english": "They speak Italian.", "note": "-ent is silent" }
              ],
              "tip": "The -s of \"tu parles\" and the -ent of \"ils parlent\" are completely silent."
            }
          ]
        },
