    {
      "id": "a1_u05_l01",
      "level": "A1",
      "unit": 5,
      "title": "Les pays",
      "description": "Name countries in French and say which country you live in.",
      "estimatedMinutes": 12,
      "sections": [
        {
          "type": "learn",
          "title": "Learn",
          "blocks": [
            {
              "heading": "Every country has a gender",
              "body": "In French, country names have a gender, just like other nouns. Most countries ending in -e are feminine: la France, l'Espagne, l'Italie. Most others are masculine: le Canada, le Japon. A few country names are plural, like les États-Unis (the United States).",
              "examples": [
                { "french": "la France", "english": "France", "note": "feminine" },
                { "french": "le Canada", "english": "Canada", "note": "masculine" },
                { "french": "les États-Unis", "english": "the United States", "note": "plural" },
                { "french": "la Belgique", "english": "Belgium", "note": "feminine — it ends in -e" },
                { "french": "le Portugal", "english": "Portugal", "note": "masculine" },
                { "french": "la Chine", "english": "China", "note": "feminine" }
              ],
              "tip": "Before a vowel, le and la become l': l'Italie, l'Espagne, l'Allemagne."
            }
          ]
        },
