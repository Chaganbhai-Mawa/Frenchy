    {
      "id": "a1_u10_l02",
      "level": "A1",
      "unit": 10,
      "title": "Demander son chemin",
      "description": "Ask where places are and understand simple directions.",
      "estimatedMinutes": 12,
      "sections": [
        {
          "type": "learn",
          "title": "Learn",
          "blocks": [
            {
              "heading": "Asking where something is",
              "body": "Start politely with \"Excusez-moi\" (excuse me), then ask \"Où est... ?\" (Where is...?). Another very French way: \"Pour aller à la gare, s'il vous plaît ?\" — literally \"to go to the station, please?\"",
              "examples": [
                { "french": "Excusez-moi, où est la gare ?", "english": "Excuse me, where is the station?" },
                { "french": "Pour aller à la gare, s'il vous plaît ?", "english": "How do I get to the station, please?" },
                { "french": "C'est loin ?", "english": "Is it far?" },
                { "french": "Excusez-moi, je cherche la poste.", "english": "Excuse me, I am looking for the post office." },
                { "french": "Où est la pharmacie, s'il vous plaît ?", "english": "Where is the pharmacy, please?" }
              ]
            },
            {
              "heading": "Understanding the answer",
              "body": "The key directions: \"à gauche\" (left), \"à droite\" (right), \"tout droit\" (straight ahead). \"Près de\" means near, \"loin de\" means far from.",
              "examples": [
                { "french": "Tournez à gauche.", "english": "Turn left." },
                { "french": "Continuez tout droit.", "english": "Keep going straight ahead." },
                { "french": "C'est près de la banque.", "english": "It's near the bank." },
                { "french": "C'est à cinq minutes à pied.", "english": "It's five minutes on foot." },
                { "french": "La poste est loin d'ici.", "english": "The post office is far from here." }
              ],
              "tip": "Don't mix up \"à droite\" (to the right) and \"tout droit\" (straight ahead) — they look similar but mean different things!"
            }
          ]
        },
        {
          "type": "vocabulary",
          "title": "Vocabulary",
          "items": [
            { "id": "ou-question", "french": "où", "english": "where", "partOfSpeech": "adverb", "pronunciation": "oo", "example": "Où est la gare ?", "exampleEnglish": "Where is the station?", "level": "A1", "category": "directions" },
            { "id": "gare", "french": "la gare", "english": "train station", "partOfSpeech": "noun", "gender": "f", "pronunciation": "gahr", "example": "La gare est près d'ici.", "exampleEnglish": "The station is near here.", "level": "A1", "category": "directions" },
            { "id": "rue", "french": "la rue", "english": "street", "partOfSpeech": "noun", "gender": "f", "pronunciation": "ru", "example": "J'habite dans cette rue.", "exampleEnglish": "I live on this street.", "level": "A1", "category": "directions" },
            { "id": "a-gauche", "french": "à gauche", "english": "to the left", "partOfSpeech": "expression", "pronunciation": "ah GOHSH", "example": "Tournez à gauche.", "exampleEnglish": "Turn left.", "level": "A1", "category": "directions" },
            { "id": "a-droite", "french": "à droite", "english": "to the right", "partOfSpeech": "expression", "pronunciation": "ah DRWAHT", "example": "La banque est à droite.", "exampleEnglish": "The bank is on the right.", "level": "A1", "category": "directions" },
            { "id": "tout-droit", "french": "tout droit", "english": "straight ahead", "partOfSpeech": "expression", "pronunciation": "too DRWAH", "example": "Continuez tout droit.", "exampleEnglish": "Keep going straight ahead.", "level": "A1", "category": "directions" },
            { "id": "pres-de", "french": "près de", "english": "near", "partOfSpeech": "expression", "pronunciation": "preh duh", "example": "C'est près de la gare.", "exampleEnglish": "It's near the station.", "level": "A1", "category": "directions" },
            { "id": "loin-de", "french": "loin de", "english": "far from", "partOfSpeech": "expression", "pronunciation": "lwan duh", "example": "C'est loin du centre.", "exampleEnglish": "It's far from the centre.", "level": "A1", "category": "directions" },
            { "id": "tourner", "french": "tourner", "english": "to turn", "partOfSpeech": "verb", "pronunciation": "toor-NAY", "example": "Tournez à droite dans la rue.", "exampleEnglish": "Turn right into the street.", "level": "A1", "category": "directions" },
            { "id": "banque", "french": "la banque", "english": "bank", "partOfSpeech": "noun", "gender": "f", "pronunciation": "bahnk", "example": "La banque est à droite.", "exampleEnglish": "The bank is on the right.", "level": "A1", "category": "directions" },
            { "id": "pharmacie", "french": "la pharmacie", "english": "pharmacy", "partOfSpeech": "noun", "gender": "f", "pronunciation": "far-mah-SEE", "example": "La pharmacie est près de la banque.", "exampleEnglish": "The pharmacy is near the bank.", "level": "A1", "category": "directions" },
            { "id": "poste", "french": "la poste", "english": "post office", "partOfSpeech": "noun", "gender": "f", "pronunciation": "post", "example": "Je cherche la poste.", "exampleEnglish": "I am looking for the post office.", "level": "A1", "category": "directions" },
            { "id": "toilettes", "french": "les toilettes", "english": "toilets", "partOfSpeech": "noun", "gender": "f", "pronunciation": "twah-LET", "example": "Où sont les toilettes ?", "exampleEnglish": "Where are the toilets?", "level": "A1", "category": "directions" },
            { "id": "continuer", "french": "continuer", "english": "to continue", "partOfSpeech": "verb", "pronunciation": "kohn-tee-nu-AY", "example": "Continuez tout droit.", "exampleEnglish": "Keep going straight ahead.", "level": "A1", "category": "directions" },
            { "id": "a-pied", "french": "à pied", "english": "on foot", "partOfSpeech": "expression", "pronunciation": "ah PYAY", "example": "C'est à dix minutes à pied.", "exampleEnglish": "It's ten minutes on foot.", "level": "A1", "category": "directions" }
          ]
        },
        {
          "type": "grammar",
          "title": "Grammar",
          "blocks": [
            {
              "heading": "Où est... ? / Où sont... ?",
              "body": "Use \"Où est\" with a singular noun and \"Où sont\" with a plural noun — the verb agrees with what you are looking for.",
              "examples": [
                { "french": "Où est la gare ?", "english": "Where is the station?", "note": "singular" },
                { "french": "Où sont les toilettes ?", "english": "Where are the toilets?", "note": "plural — a very useful question!" },
                { "french": "Où est la pharmacie ?", "english": "Where is the pharmacy?", "note": "singular" },
                { "french": "Où sont les magasins ?", "english": "Where are the shops?", "note": "plural" }
              ],
              "tip": "\"Les toilettes\" is always plural in French, so it is always \"Où sont les toilettes ?\""
            }
          ]
        },
