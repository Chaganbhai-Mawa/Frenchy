          "title": "Learn",
          "blocks": [
            {
              "heading": "Ordering politely",
              "body": "The magic phrase for ordering is \"je voudrais\" (I would like) — much more polite than \"je veux\" (I want). Always add \"s'il vous plaît\". The waiter may ask \"Vous désirez ?\" (What would you like?).",
              "examples": [
                { "french": "Je voudrais un café, s'il vous plaît.", "english": "I would like a coffee, please." },
                { "french": "Vous désirez ?", "english": "What would you like?", "note": "the waiter's question" },
                { "french": "Une carafe d'eau, s'il vous plaît.", "english": "A jug of water, please." },
                { "french": "Je voudrais un sandwich au fromage, s'il vous plaît.", "english": "I would like a cheese sandwich, please." },
                { "french": "Et une limonade pour madame.", "english": "And a lemonade for the lady." }
              ],
              "tip": "In a café, \"un café\" means an espresso. If you want milk in it, ask for \"un café crème\"."
            },
            {
              "heading": "Paying",
              "body": "When you want to pay, ask for \"l'addition\" (the bill). The waiter tells you the total with \"Ça fait...\" (That comes to...).",
              "examples": [
                { "french": "L'addition, s'il vous plaît !", "english": "The bill, please!" },
                { "french": "Ça fait sept euros.", "english": "That's seven euros." },
                { "french": "Ça fait combien ?", "english": "How much is it?" },
                { "french": "Il laisse un pourboire à la serveuse.", "english": "He leaves a tip for the waitress." }
              ]
            }
          ]
        },
