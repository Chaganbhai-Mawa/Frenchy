    {
      "id": "a1_u06_l02",
      "level": "A1",
      "unit": 6,
      "title": "J'aime le café",
      "description": "Say what you like, love and hate — food edition.",
      "estimatedMinutes": 12,
      "sections": [
        {
          "type": "learn",
          "title": "Learn",
          "blocks": [
            {
              "heading": "Like, love, hate",
              "body": "Three key verbs for your tastes: \"aimer\" (to like / to love), \"adorer\" (to love, stronger) and \"détester\" (to hate). Before a vowel, je becomes j': j'aime, j'adore. You can soften or strengthen with \"beaucoup\" (a lot): j'aime beaucoup le thé.",
              "examples": [
                { "french": "J'aime le café.", "english": "I like coffee." },
                { "french": "J'adore les croissants !", "english": "I love croissants!" },
                { "french": "Je déteste le lait.", "english": "I hate milk." },
                { "french": "Je préfère le thé.", "english": "I prefer tea." },
                { "french": "J'aime beaucoup la glace.", "english": "I like ice cream a lot." }
              ],
              "tip": "\"J'aime\" — never \"je aime\". French drops the e of \"je\" before a vowel sound."
            }
          ]
        },
        {
          "type": "vocabulary",
          "title": "Vocabulary",
          "items": [
            { "id": "aimer", "french": "aimer", "english": "to like / to love", "partOfSpeech": "verb", "pronunciation": "eh-MAY", "example": "J'aime le chocolat.", "exampleEnglish": "I like chocolate.", "level": "A1", "category": "food" },
            { "id": "adorer", "french": "adorer", "english": "to love / to adore", "partOfSpeech": "verb", "pronunciation": "ah-doh-RAY", "example": "J'adore les croissants !", "exampleEnglish": "I love croissants!", "level": "A1", "category": "food" },
            { "id": "detester", "french": "détester", "english": "to hate", "partOfSpeech": "verb", "pronunciation": "day-teh-STAY", "example": "Il déteste le fromage.", "exampleEnglish": "He hates cheese.", "level": "A1", "category": "food" },
            { "id": "preferer", "french": "préférer", "english": "to prefer", "partOfSpeech": "verb", "pronunciation": "pray-fay-RAY", "example": "Je préfère le thé.", "exampleEnglish": "I prefer tea.", "level": "A1", "category": "food" },
            { "id": "cafe", "french": "le café", "english": "coffee", "partOfSpeech": "noun", "gender": "m", "pronunciation": "luh kah-FAY", "example": "Tu aimes le café ?", "exampleEnglish": "Do you like coffee?", "level": "A1", "category": "food" },
            { "id": "chocolat", "french": "le chocolat", "english": "chocolate", "partOfSpeech": "noun", "gender": "m", "pronunciation": "shoh-koh-LAH", "example": "J'adore le chocolat.", "exampleEnglish": "I love chocolate.", "level": "A1", "category": "food" },
            { "id": "fromage", "french": "le fromage", "english": "cheese", "partOfSpeech": "noun", "gender": "m", "pronunciation": "froh-MAHZH", "example": "La France adore le fromage.", "exampleEnglish": "France loves cheese.", "level": "A1", "category": "food" },
            { "id": "beaucoup", "french": "beaucoup", "english": "a lot / very much", "partOfSpeech": "adverb", "pronunciation": "boh-KOO", "example": "J'aime beaucoup le thé.", "exampleEnglish": "I like tea a lot.", "level": "A1", "category": "basics" },
            { "id": "gateau", "french": "le gâteau", "english": "cake", "partOfSpeech": "noun", "gender": "m", "pronunciation": "luh gah-TOH", "example": "Nous adorons le gâteau au chocolat.", "exampleEnglish": "We love chocolate cake.", "level": "A1", "category": "food" },
            { "id": "glace", "french": "la glace", "english": "ice cream", "partOfSpeech": "noun", "gender": "f", "pronunciation": "lah GLAHSS", "example": "Elle adore la glace à la vanille.", "exampleEnglish": "She loves vanilla ice cream.", "level": "A1", "category": "food" },
            { "id": "poisson", "french": "le poisson", "english": "fish", "partOfSpeech": "noun", "gender": "m", "pronunciation": "luh pwah-SOHN", "example": "Je préfère le poisson.", "exampleEnglish": "I prefer fish.", "level": "A1", "category": "food" },
            { "id": "viande", "french": "la viande", "english": "meat", "partOfSpeech": "noun", "gender": "f", "pronunciation": "lah VYAHND", "example": "Il ne mange pas de viande.", "exampleEnglish": "He doesn't eat meat.", "level": "A1", "category": "food" },
            { "id": "salade", "french": "la salade", "english": "salad", "partOfSpeech": "noun", "gender": "f", "pronunciation": "lah sah-LAHD", "example": "J'aime la salade verte.", "exampleEnglish": "I like green salad.", "level": "A1", "category": "food" },
            { "id": "epinards", "french": "les épinards", "english": "spinach", "partOfSpeech": "noun", "gender": "m", "pronunciation": "lay zay-pee-NAR", "example": "Ils détestent les épinards.", "exampleEnglish": "They hate spinach.", "level": "A1", "category": "food" }
          ]
        },
        {
          "type": "grammar",
          "title": "Grammar",
          "blocks": [
            {
              "heading": "Aimer + le / la / les",
              "body": "After verbs of liking — aimer, adorer, détester, préférer — French always uses the definite article le, la or les, even when speaking in general. English says \"I like coffee\", but French says \"J'aime LE café\", never \"j'aime du café\".",
              "examples": [
                { "french": "J'aime le café.", "english": "I like coffee." },
                { "french": "Elle adore la confiture.", "english": "She loves jam." },
                { "french": "Ils détestent les épinards.", "english": "They hate spinach." },
                { "french": "Nous adorons le gâteau au chocolat.", "english": "We love chocolate cake." },
                { "french": "Tu aimes la salade ?", "english": "Do you like salad?" }
              ],
              "tip": "Compare: \"Je bois du café\" (I drink some coffee — an amount) but \"J'aime le café\" (I like coffee — in general)."
            }
          ]
        },
